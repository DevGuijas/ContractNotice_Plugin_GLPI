{% extends "layout/page_skeleton.html.twig" %}

{% set title = page_title %}
{% set menu = ['admin', menu_item, 'contractnotice'] %}

{% block content %}
<div class="container-fluid">
   <div class="card">
      <div class="card-body">
         <div class="alert alert-warning mb-0" role="alert">
            <div class="d-flex">
               <i class="ti ti-alert-triangle fs-2 me-3"></i>
               <div>
                  <h2 class="alert-title">Atualização necessária</h2>
                  <p class="mb-3">As tabelas da Central de Avisos ainda não foram criadas. Isso ocorre quando os arquivos do plugin são copiados, mas a atualização não é executada no GLPI.</p>
                  <a class="btn btn-warning" href="{{ plugins_url }}">Abrir Configuração &gt; Plugins</a>
                  <p class="text-secondary small mt-3 mb-0">Localize “Aviso de Contratos”, clique em <strong>Atualizar</strong> e mantenha o plugin ativo. Depois retorne a esta página.</p>
               </div>
            </div>
         </div>
      </div>
   </div>
</div>
{% endblock content %}
